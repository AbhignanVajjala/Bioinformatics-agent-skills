{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analysis_run",
  "description": "Project artifact contract v1; structural validity is not scientific validation.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "git_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "software": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "object"
    },
    "random_seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "exit_status": {
      "type": "integer"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "git_revision",
    "software",
    "inputs",
    "parameters",
    "random_seed",
    "commands",
    "started_at",
    "ended_at",
    "exit_status",
    "outputs"
  ],
  "additionalProperties": false
}
