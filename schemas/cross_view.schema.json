{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executed descriptive cross-view report version 2",
  "type": "object",
  "required": ["report_version", "analysis_status", "correlations", "audit", "normalization", "numerical_evidence", "inference_status", "prediction_status"],
  "properties": {
    "report_version": {"const": 2},
    "analysis_status": {"const": "EXECUTED"},
    "inference_status": {"const": "NOT_RUN"},
    "prediction_status": {"const": "NOT_RUN"},
    "correlations": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["pearson_r"], "properties": {"pearson_r": {"type": "number", "minimum": -1, "maximum": 1}}}
    },
    "audit": {"type": "object", "required": ["matched_specimen_count", "matched_subject_count", "partitions", "specimens_per_subject", "warnings"]},
    "normalization": {"type": "object"},
    "numerical_evidence": {"type": "object", "required": ["status", "events", "method"], "properties": {"status": {"const": "PASS"}, "events": {"type": "array", "maxItems": 0}}}
  }
}
