{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dataset_manifest",
  "description": "Project artifact contract v1; structural validity is not scientific validation.",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "access_restrictions": {
      "type": "string",
      "minLength": 1
    },
    "organism": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "type": "string",
      "minLength": 1
    },
    "sample_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "subject_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assay": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "accession": {
      "type": "string",
      "minLength": 1
    },
    "download_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "source",
    "synthetic",
    "access_restrictions",
    "organism",
    "modality",
    "sample_ids",
    "reference",
    "version",
    "license",
    "files"
  ],
  "additionalProperties": false
}
