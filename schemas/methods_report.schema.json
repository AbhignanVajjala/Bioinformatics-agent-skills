{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "methods_report",
  "description": "Project artifact contract v1; structural validity is not scientific validation.",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "processing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "statistical_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "verification_status": {
            "enum": [
              "verified",
              "unverified"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "url",
          "verification_status",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "data",
    "processing",
    "statistical_methods",
    "exclusions",
    "citations",
    "environment",
    "limitations"
  ],
  "additionalProperties": false
}
