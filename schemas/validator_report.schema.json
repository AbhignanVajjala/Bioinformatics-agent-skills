{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "validator", "status", "checks", "reason", "inputs", "input_hashes", "software_versions", "limitations", "recommended_action"],
  "properties": {
    "schema_version": {"const": 1},
    "validator": {"type": "string"},
    "status": {"enum": ["PASS", "WARN", "FAIL", "BLOCKED", "NOT_RUN"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "reason": {"type": "string", "minLength": 1},
    "inputs": {"type": "object", "additionalProperties": {"type": "string"}},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "software_versions": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "recommended_action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
